{
  "name": "mcp-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "MCP server that gives an AI agent sandboxed, permissioned access to local notes and tasks",
  "license": "MIT",
  "author": "Juan Martínez Jiménez",
  "type": "module",
  "bin": {
    "mcp-workspace": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "npm run build && vitest run",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
